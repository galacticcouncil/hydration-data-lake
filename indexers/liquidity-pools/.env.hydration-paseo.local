##STORAGE_DICTIONARY_LBPPOOL_URL=http://localhost:8090/graphql
##STORAGE_DICTIONARY_XYKPOOL_URL=http://localhost:8090/graphql
##STORAGE_DICTIONARY_OMNIPOOL_URL=http://glocalhost:8090/graphql
##STORAGE_DICTIONARY_STABLEPOOL_URL=http://gallocalhost:8090/graphql



CHAIN=hydration_paseo
NODE_ENV=development

DB_NAME=liquidity_pools_db
DB_PORT=23798

GQL_PORT=8080

ORCHESTRATOR_QUEUE_REDIS_HOST=localhost
ORCHESTRATOR_QUEUE_REDIS_PORT=6378
ORCHESTRATOR_QUEUE_REDIS_PASS=orchestra

TS_REDIS_HOST=localhost
TS_REDIS_PORT=6379
TS_REDIS_PASS=password
TS_REDIS_KEY_SPACE_ID=3

RPC_URL=wss://paseo-rpc.play.hydration.cloud
RPC_URL_HTTPS=https://paseo-rpc.play.hydration.cloud
IGNORE_ARCHIVE_DATA_SOURCE=true
USE_STORAGE_DICTIONARY=false

NODE_OPTIONS=--max-old-space-size=4048


HISTORICAL_DATA_PROCESSING_SUB_BATCH_SIZE=20

ASSET_SPOT_PRICE_ASSET_OUT_IDS=10
ASSET_PRICE_BASE_ASSET_ID=10

PROCESS_LBP_POOLS=true
PROCESS_XYK_POOLS=true
PROCESS_OMNIPOOLS=true
PROCESS_STABLEPOOLS=true
PROCESS_DCA=true
PROCESS_OTC=true

PERSIST_HIST_DATA_ONLY_ON_CHANGE=true

USE_XYKPOOLS_DATA_IN_TRADE_ROUTER=false

HLOG_CONSOLE_LOGS_VERBOSE=true

INDEXER_ID=local_1
ALL_IN_ONE_PROCESSOR_MODE=true
IS_SPOT_PRICES_PROCESSOR=false
IS_CORE_PROCESSOR=false

OMNIPOOL_ADDRESS=0x6d6f646c6f6d6e69706f6f6c0000000000000000000000000000000000000000

UNIFIED_EVENTS_GENESIS_SPEC_VERSION=282

SUBSCAN_PRO_API_SECRET=
SUBSCAN_PROXY_API_CORS_ALLOWED_SUFFIXES=hydration.net::-hydra-app.netlify.app
SUBSCAN_PROXY_API_CORS_ALLOW_LOCALHOST=true

ENSURE_PREFETCH_PERSISTENT_DATA_FOR_SPOT_PRICE=false

ACCOUNT_BALANCES_REAGGREGATION_BATCH_SIZE=100

PROCESS_FROM_BLOCK=1110000
PROCESS_TO_BLOCK=-1

ASYNC_OPERATIONS_CONCURRENCY_COMMON=1
EVM_CONTRACT_CALL_CONCURRENCY=1
RUNTIME_API_CALLS_CONCURRENCY=1


