STORAGE_DICTIONARY_XYKPOOL_URL=https://storage-dict-xyk-hist-data-v2.orca.hydration.cloud/graphql
STORAGE_DICTIONARY_OMNIPOOL_URL=https://storage-dict-omnipool-hist-data-v2.orca.hydration.cloud/graphql
