{
  "name": "liquidity-pools",
  "description": "An indexer for the Hydration mainnet and Paseo chains, designed to collect and organize data on liquidity pools.",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "process": "node --require=dotenv/config lib/main.js",
    "build": "rm -rf lib && tsc",
    "node-pg-migrate": "node-pg-migrate",
    "postbuild": "cpx 'src/**/*.sql' lib && cpx 'src/**/*.graphql' lib && cpx 'src/**/*.json5' lib",
    "deploy": "sqd deploy --org galacticcouncil . -m deployment-hydration-indexer.yaml",
    "ingester-codegen:all": ". ./scripts/ingester-codegen.sh",
    "multi-typegen": ". ./scripts/typegen.sh",
    "api-codegen:dictionary-api": "graphql-codegen --require dotenv/config --config dictionaryGqlTypesConfig/codegen-dictionary-common.ts",
    "explore-metadata": "npx squid-substrate-metadata-explorer --rpc wss://paseo-rpc.play.hydration.cloud --out ./typegenAssets/paseo-metadata.jsonl",
    "papi-typegen": "npx papi add -w wss://hydration-rpc.n.dwellir.com hydration",
    "postpapi-typegen": "rm .papi/descriptors/.gitignore"
  },
  "dependencies": {
    "@aave/contract-helpers": "1.28.0",
    "@aave/math-utils": "^1.32.1",
    "@ethersproject/abi": "^5.8.0",
    "@galacticcouncil/sdk": "^4.2.1",
    "@graphile-contrib/pg-simplify-inflector": "^6.1.0",
    "@graphile/pg-aggregates": "^0.1.1",
    "@graphile/pg-pubsub": "^4.13.0",
    "@polkadot/api": "^14.0.1",
    "@subsquid/graphql-server": "^4.5.1",
    "@subsquid/ss58": "^2.0.2",
    "@subsquid/substrate-processor": "^8.3.0",
    "@subsquid/substrate-runtime": "^2.0.0",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "^1.4.0",
    "@urql/core": "^5.0.8",
    "@urql/exchange-retry": "^1.3.0",
    "axios": "^1.8.1",
    "bignumber.js": "^9.1.2",
    "class-transformer": "^0.5.1",
    "class-transformer-validator": "^0.9.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "cpx2": "^8.0.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "ethers": "^5.x",
    "express": "^4.21.1",
    "lodash.camelcase": "^4.3.0",
    "node-pg-migrate": "^7.7.1",
    "pg": "^8.11.5",
    "polkadot-api": "^1.9.7",
    "postgraphile": "^4.13.0",
    "postgraphile-plugin-connection-filter": "^2.3.0",
    "scale-ts": "^1.6.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@polkadot/api": "^14.0.1",
    "@polkadot/api-augment": "^14.0.1",
    "@polkadot/api-base": "^14.0.1",
    "@polkadot/api-derive": "^14.0.1",
    "@polkadot/keyring": "^13.1.1",
    "@polkadot/rpc-augment": "^14.0.1",
    "@polkadot/rpc-core": "^14.0.1",
    "@polkadot/rpc-provider": "^14.0.1",
    "@polkadot/typegen": "^14.3.1",
    "@polkadot/types": "^14.0.1",
    "@polkadot/types-augment": "^14.0.1",
    "@polkadot/types-codec": "^14.0.1",
    "@polkadot/types-create": "^14.0.1",
    "@polkadot/types-known": "^14.0.1",
    "@polkadot/util": "^13.1.1",
    "@polkadot/util-crypto": "^13.1.1",
    "@subsquid/substrate-metadata-explorer": "^3.1.2",
    "@subsquid/substrate-typegen": "^8.1.0",
    "@subsquid/typeorm-codegen": "^2.0.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/lodash.camelcase": "^4.3.9",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "turbo": "^2.2.3",
    "typescript": "^5.5.4"
  },
  "resolutions": {
    "ethers": "^5.x",
    "@polkadot/util": "~13.1.1",
    "@polkadot/util-crypto": "~13.1.1",
    "@polkadot/keyring": "~13.1.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "modulePaths": [
      "<rootDir>"
    ],
    "testRegex": "(.*\\.api\\.ts$)",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "jest-extended/all"
    ]
  }
}
