{
  "name": "liquidity-pools",
  "description": "An indexer for the Hydration mainnet and Paseo chains, designed to collect and organize data on liquidity pools.",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "process": "node --require=dotenv/config lib/main.js",
    "build": "rm -rf lib && tsc",
    "node-pg-migrate": "node-pg-migrate",
    "postbuild": "cpx 'src/**/*.sql' lib && cpx 'src/**/*.graphql' lib && cpx 'src/**/*.json5' lib",
    "deploy": "sqd deploy --org galacticcouncil . -m deployment-hydration-indexer.yaml",
    "ingester-codegen:all": ". ./scripts/ingester-codegen.sh",
    "multi-typegen": ". ./scripts/typegen.sh",
    "api-codegen:dictionary-api": "npx graphql-codegen --require dotenv/config --config dictionaryGqlTypesConfig/codegen-dictionary-common.ts",
    "explore-metadata": "npx squid-substrate-metadata-explorer --rpc wss://paseo-rpc.play.hydration.cloud --out ./typegenAssets/paseo-metadata.jsonl",
    "explore-metadata-hollar": "npx squid-substrate-metadata-explorer --rpc wss://nomax.lark.hydration.cloud --out ./typegenAssets/one-lark-metadata.jsonl",
    "papi-typegen": "npx papi add -w wss://hydration-rpc.n.dwellir.com hydration",
    "postpapi-typegen": "rm .papi/descriptors/.gitignore",
    "clinic:frame": "sqd build && sqd migration:apply && clinic flame -- node --require=dotenv/config lib/main.js"
  },
  "dependencies": {
    "@aave/contract-helpers": "1.28.0",
    "@aave/math-utils": "^1.32.1",
    "@bull-board/api": "^6.9.6",
    "@bull-board/express": "^6.9.6",
    "@ethersproject/abi": "^5.8.0",
    "@galacticcouncil/api-augment": "^0.9.0",
    "@galacticcouncil/math-lbp": "^1.1.0",
    "@galacticcouncil/math-liquidity-mining": "^1.1.0",
    "@galacticcouncil/math-omnipool": "^1.3.0",
    "@galacticcouncil/math-stableswap": "^2.2.0",
    "@galacticcouncil/math-xyk": "^1.1.0",
    "@galacticcouncil/sdk": "^10.4.0",
    "@graphile-contrib/pg-simplify-inflector": "^6.1.0",
    "@graphile/pg-aggregates": "^0.1.1",
    "@graphile/pg-pubsub": "^4.13.0",
    "@keyv/postgres": "^2.1.6",
    "@polkadot/api": "^16.4.8",
    "@polkadot/api-augment": "^16.4.8",
    "@polkadot/api-base": "^16.4.8",
    "@polkadot/api-derive": "^16.4.8",
    "@polkadot/rpc-augment": "^16.4.8",
    "@polkadot/rpc-core": "^16.4.8",
    "@polkadot/rpc-provider": "^16.4.8",
