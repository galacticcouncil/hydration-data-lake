CHAIN=hydration
NODE_ENV=development

DB_NAME=liquidity_pools_db
DB_PORT=23798

GQL_PORT=8080

ORCHESTRATOR_QUEUE_REDIS_HOST=localhost
ORCHESTRATOR_QUEUE_REDIS_PORT=6378
ORCHESTRATOR_QUEUE_REDIS_PASS=orchestra


TS_REDIS_HOST=localhost
TS_REDIS_PORT=6379
TS_REDIS_PASS=password
TS_REDIS_KEY_SPACE_ID=3

RPC_URL=wss://node-subwhale-10.shellfish.hydration.cloud
RPC_URL_HTTPS=https://node-subwhale-10.shellfish.hydration.cloud

NODE_OPTIONS=--max-old-space-size=8048


GATEWAY_HYDRATION_HTTPS=https://v2.archive.subsquid.io/network/hydradx

HISTORICAL_DATA_PROCESSING_SUB_BATCH_SIZE=20


#REAGGREGATION_PROCESSING_MODE=true
