{
  "name": "storage-dictionary",
  "description": "An indexer for Hydration mainnet chains, built to collect historical storage data for each block. Optimized for fast, filtered access to storage data with minimal latency.",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "rm -rf lib && tsc",
    "node-pg-migrate": "node-pg-migrate",
    "postbuild": "cpx 'src/**/*.sql' lib",
    "deploy-main": "sqd deploy --org galacticcouncil . -m deployment-xyk-pool.yaml"
  },
