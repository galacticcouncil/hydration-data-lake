NODE_ENV=development
DB_NAME=store_dictionary_db
DB_PORT=23799
GQL_PORT=8090

RPC_URL=wss://node-owl-3.owl.shadow-senate.com
RPC_URL_HTTPS=https://node-owl-3.owl.shadow-senate.com

IGNORE_ARCHIVE_DATA_SOURCE=false
GATEWAY_HYDRATION_HTTPS=https://v2.archive.subsquid.io/network/hydradx
GATEWAY_HYDRATION_API_KEY=

# Uncommenting this line enables the debug mode
# More info at https://docs.subsquid.io/basics/logging/
#SQD_DEBUG=*

PROCESS_LBP_POOLS=true
PROCESS_XYK_POOLS=true
PROCESS_OMNIPOOLS=true
PROCESS_STABLEPOOLS=true
PROCESS_GENERIC_HIST_DATA=true
PROCESS_ACCOUNTS=true

ASSETS_TRACKER_PROCESSOR=true

PROCESS_ONLY_MISSED_BLOCKS=false

PERSIST_HIST_DATA_ONLY_ON_CHANGE=true

PROCESS_FROM_BLOCK=12322741
PROCESS_TO_BLOCK=12322750

STATE_SCHEMA_NAME=processor_segment_1
ASSETS_ACTUALISATION_PROC_STATE_SCHEMA_NAME=processor_segment_1
SUB_BATCH_SIZE=50
INDEXER_MAX_SUB_BATCH_SIZE=50
SUB_BATCH_MAX_TIMEOUT_MS=500

OMNIPOOL_ADDRESS=0x6d6f646c6f6d6e69706f6f6c0000000000000000000000000000000000000000


