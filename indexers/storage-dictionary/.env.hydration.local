NODE_ENV=development
DB_NAME=store_dictionary_db
DB_PORT=23799
GQL_PORT=8090

# JSON-RPC node endpoints (wss or https)
# Use private endpoints in production! If deploying to Cloud:
# - use our RPC proxy service: https://docs.subsquid.io/cloud/resources/rpc-proxy/, OR
# - save your private url as a secret: https://docs.subsquid.io/cloud/resources/env-variables/#secrets
RPC_URL=wss://node-subwhale-7.shellfish.hydration.cloud
#RPC_URL=wss://3.rpc.hydration.cloud
RPC_URL_HTTPS=https://node-subwhale-7.shellfish.hydration.cloud

IGNORE_ARCHIVE_DATA_SOURCE=false
GATEWAY_HYDRATION_HTTPS=https://v2.archive.subsquid.io/network/hydradx

# Uncommenting this line enables the debug mode
# More info at https://docs.subsquid.io/basics/logging/
#SQD_DEBUG=*

PROCESS_LBP_POOLS=false
PROCESS_XYK_POOLS=false
PROCESS_OMNIPOOLS=false
PROCESS_STABLEPOOLS=true
PROCESS_GENERIC_HIST_DATA=false
PROCESS_ACCOUNTS=false

ASSETS_TRACKER_PROCESSOR=true

PROCESS_ONLY_MISSED_BLOCKS=false

PERSIST_HIST_DATA_ONLY_ON_CHANGE=true

PROCESS_FROM_BLOCK=9826751
PROCESS_TO_BLOCK=9826770


STATE_SCHEMA_NAME=processor_segment_1
ASSETS_ACTUALISATION_PROC_STATE_SCHEMA_NAME=processor_segment_1
SUB_BATCH_SIZE=50
INDEXER_MAX_SUB_BATCH_SIZE=50
SUB_BATCH_MAX_TIMEOUT_MS=500

#SUB_PROCESSORS_RANGES = "processor_segment_1:3640110:3840140"


OMNIPOOL_ADDRESS=0x6d6f646c6f6d6e69706f6f6c0000000000000000000000000000000000000000


