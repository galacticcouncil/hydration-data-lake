{
  "name": "hydration-data-lake-health-checker",
  "version": "0.0.1",
  "description": "Application for checking Hydration Indexers API.",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "indexer-api-codegen": "graphql-codegen --require dotenv/config --config indexer-api-codegen-configs/index.ts",
    "papi-typegen": "npx papi add -w wss://hydration-rpc.n.dwellir.com hydration",
    "postpapi-typegen": "rm .papi/descriptors/.gitignore",
    "db-up": "docker compose up -d"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.7",
    "@bull-board/express": "^6.7.9",
    "@bull-board/nestjs": "^6.7.9",
    "@nestjs/bull": "^11.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "@polkadot/api": "^16.4.8",
    "@polkadot/util": "^13.5.6",
    "@polkadot/util-crypto": "^13.5.6",
    "@urql/core": "^5.1.0",
    "@urql/exchange-retry": "^1.3.0",
    "bignumber": "^1.1.0",
    "bignumber.js": "^9.1.2",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-transformer-validator": "^0.9.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.13",
    "discord.js": "^14.18.0",
    "ethers": "^6.13.5",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.1",
    "ioredis": "^5.5.0",
    "markdown-to-ansi": "^1.0.0",
    "marked": "^15.0.7",
    "marked-terminal": "^7.3.0",
    "polkadot-api": "^2.1.0",
    "redis": "^4.7.1",
    "redis-om": "^0.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "^5.0.4",
    "@graphql-codegen/typescript-document-nodes": "^4.0.13",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
